{
  "name": "pwayment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWAyment - offline-first POS voor Belgische skateshops en retail.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run generate:site",
    "build": "vite build && node scripts/build-sites-worker.mjs",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:e2e": "VITE_E2E_BUILD=true vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "supabase:generate-demo": "tsx scripts/generate-supabase-demo-migration.ts supabase/migrations/20260811071000_seed_kevin_demo.sql",
    "generate:site": "node scripts/generate-public-site-assets.mjs",
    "check:site": "node scripts/check-public-site.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:security": "npm audit --audit-level=high",
    "check": "npm run lint && npm run test:coverage && npm run build && npm run check:site && npm run check:bundle"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
